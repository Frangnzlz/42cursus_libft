#include "libft.h"

char	*ft_substr(char const *s, unsigned int start, size_t len)
{
	char	*sub_s;
	size_t	i;
	if (!s)
		return (NULL);
	if (ft_strlen(s) < start)
		return (ft_substr("", 0, 0));
	sub_s = ft_calloc(len + 1, sizeof(char));
	if (!sub_s)
		return (NULL);
	i = 0;
	while (s && s[start + (unsigned int)i] && i < len)
	{
		sub_s[i] = s[start + (unsigned int)i];
		i++;
	}
	return (sub_s);
}
